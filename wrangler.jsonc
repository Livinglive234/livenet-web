{
  // Cloudflare Worker config for livenet.host.
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "livenet",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Keep the site off the default *.workers.dev address. It is only served on livenet.host.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/*, /admin, /blog, /auth/*, /account and /account/* run the Worker. Everything else is served straight from public/.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/blog", "/blog/*", "/auth/*", "/account", "/account/*"]
  },

  // Sign in with LiveNet (Authentik). The client ID, client secret and SESSION_SECRET are Worker secrets.
  // The slug at the end must match the provider's application slug in Authentik.
  "vars": { "OIDC_ISSUER": "https://auth.livenet.host/application/o/livenet-site/" },

  // Beta requests. The id is an identifier, not a secret: using the namespace needs
  // your Cloudflare login or this Worker's binding.
  "kv_namespaces": [{ "binding": "BETA_REQUESTS", "id": "904f65854b2e426e92d411aecaef0720" }]
}
