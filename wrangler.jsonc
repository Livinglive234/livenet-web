{
  // Cloudflare Worker config for livenet.host.
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "livenet",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Keep the site off the default *.workers.dev address. It is only served on livenet.host.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/*, /admin, /blog, /auth/*, /account, /account/* and /beta run the Worker. Everything else is served straight from public/.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/blog", "/blog/*", "/auth/*", "/account", "/account/*", "/beta", "/beta/"]
  },

  // Sign in with LiveNet (Authentik). The client ID, client secret and SESSION_SECRET are Worker secrets.
  // The slug at the end must match the provider's application slug in Authentik.
  "vars": {
    "OIDC_ISSUER": "https://auth.livenet.host/application/o/livenet-site/",
    // The Authentik scope that reports 2FA status (see docs/signin.md). Empty means the site does
    // not ask for it. If it is set but the scope is missing in Authentik, signing in may fail.
    "OIDC_MFA_SCOPE": "livenet_mfa",
    // Social sign-in sources linked from /account (see docs/signin.md). Slugs of the sources that exist in
    // Authentik, from: google, discord, github. Empty hides the section.
    "SOCIAL_SOURCES": ""
  },

  // Beta requests. The id is an identifier, not a secret: using the namespace needs
  // your Cloudflare login or this Worker's binding.
  "kv_namespaces": [{ "binding": "BETA_REQUESTS", "id": "904f65854b2e426e92d411aecaef0720" }]
}
