{
  // Cloudflare Worker config for livenet.host.
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "livenet",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Keep the site off the default *.workers.dev address. It is only served on livenet.host.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker. Everything else is served straight from public/.
    "run_worker_first": ["/api/*"]
  }

  // After creating the KV namespace for beta requests, add:
  // "kv_namespaces": [{ "binding": "BETA_REQUESTS", "id": "<namespace id>" }]
}
